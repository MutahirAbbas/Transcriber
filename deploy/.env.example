# /srv/call-analyzer/.env on the server — chmod 600, read only by the app container.
ANTHROPIC_API_KEY=
SCORER_MODEL=claude-sonnet-5-5
WORKER_MODE=remote
# openssl rand -hex 32 — the Mac's worker.env needs the same value
WORKER_TOKEN=
# openssl rand -hex 32 — signs sign-in cookies; changing it signs everyone out
SESSION_SECRET=
# where the app is served (for reference; Caddy's site address is in deploy/Caddyfile)
PUBLIC_URL=https://calls.tqc4.ai

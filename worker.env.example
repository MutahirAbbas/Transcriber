# Mac transcription worker: python -m worker.remote_worker, or scripts/install_worker_mac.sh.
# Copy to worker.env (gitignored; the install script makes it chmod 600) and fill in.
SERVER_URL=https://calls.tqc4.ai
WORKER_TOKEN=
# Required to talk to anything but this machine. Leave it out in a dev checkout: the worker then
# refuses to start unless SERVER_URL is localhost / 127.0.0.1.
WORKER_MODE=remote-production
# Name shown in the app's sidebar (default: this Mac's name)
# WORKER_ID="Mutahir's Mac"
# TRANSCRIBER=whisper_local
# Separate speakers on mono recordings. Needs a Hugging Face token whose account has accepted
# https://huggingface.co/pyannote/speaker-diarization-community-1
# DIARIZER=pyannote
# HF_TOKEN=

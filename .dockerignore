!api
!api/**
!transcribers
!transcribers/**
!scoring
!scoring/**
!pipeline.py
!scripts/upgrade_calls_v2.py
!requirements-server.txt
!data/keywords.txt
!web
!web/**
web/node_modules
web/dist
**/__pycache__
**/*.pyc
**/.DS_Store

DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
ANTHROPIC_API_KEY=
SCORER_MODEL=claude-sonnet-5-5
TRANSCRIBER=whisper_local
# optional — defaults shown
# CALLBENCH_DB=data/call-bench.db
# CALLBENCH_UPLOADS_DIR=data/uploads
# Local dev: transcribe and score on this Mac, no sign-in. Never set AUTH_DISABLED on a server
# (it's ignored when WORKER_MODE=remote). To try sign-in locally instead, drop AUTH_DISABLED, set
# SESSION_SECRET=$(openssl rand -hex 32) and run: python -m api.users add you@example.com
WORKER_MODE=local
AUTH_DISABLED=1
